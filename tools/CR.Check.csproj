  <!-- 오프라인 컴파일 검사 — Unity 라이선스도 에디터도 필요 없다 (~6 s).
       좀비퀸 tools/ZQ.Check.csproj 에서 가져온 틀: 설치된 Unity DLL 을 직접 참조해
       Assets/_Game/Scripts/** 를 컴파일한다. 세션 A 의 tools/sim 은 Core 전용(UnityEngine 없음)이라
       UnityEngine 을 쓰는 코드는 이쪽이 아니면 **빌드할 때까지 안 터진다**.
       경로는 이 파일 기준 상대다 — 두 PC 에서 같이 쓰려면 절대 경로를 박지 않는다
       (좀비퀸에서 한쪽 PC 절대 경로가 박혀 **0 파일 컴파일하고 "오류 0" 을 찍은** 적이 있다). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS1591</NoWarn>
    <DefineConstants>UNITY_EDITOR;UNITY_2023_1_OR_NEWER;UNITY_INCLUDE_TESTS</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\Assets\_Game\Scripts\**\*.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\Assets\Tests\**\*.cs" />
  </ItemGroup>
  <!-- ⚠ **이 목록이 프로젝트의 패키지와 같아야 한다.**
